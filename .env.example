# Backend only. Never put service secrets in VITE_ variables.
PORT=8787
ALLOWED_ORIGIN=http://127.0.0.1:5173
API_TOKEN=
EXA_API_KEY=
DAYTONA_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Managed Nosana inference: this key is enough; serving model is discovered automatically.
NOSANA_API_KEY=
# Optional override for a private vLLM deployment. Base includes /v1.
NOSANA_INFERENCE_URL=
NOSANA_MODEL=
NOSANA_INFERENCE_KEY=
# Agent starts when required credentials are configured; proposals always require review.
AGENT_ENABLED=true
AGENT_INTERVAL_MINUTES=1440
AGENT_MAX_SEARCHES_PER_DAY=12
AGENT_MAX_SOURCES_PER_RUN=6
REPORT_HOSTS=investor.nvidia.com,nvidianews.nvidia.com,investor.microsoft.com,www.microsoft.com,investor.apple.com,www.apple.com,www.sec.gov
# Optional frontend configuration: public API URL only, no credentials.
VITE_API_URL=
